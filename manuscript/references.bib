@article{bourginHypocretin1ModulatesRapid2000,
  title = {Hypocretin-1 {{Modulates Rapid Eye Movement Sleep}} through {{Activation}} of {{Locus Coeruleus Neurons}}},
  author = {Bourgin, P. and Huitrón‐Reséndiz, S. and Spier, A. D. and Fabre, V. and Morte, B. and Criado, J. and Sutcliffe, J. and Henriksen, S. and Lecea, L.},
  date = {2000},
  journaltitle = {The Journal of Neuroscience},
  shortjournal = {J. Neurosci.},
  volume = {20},
