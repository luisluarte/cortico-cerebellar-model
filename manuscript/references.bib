@article{kilpatrickUncertaintyDrivesDeviations2021,
  title = {Uncertainty Drives Deviations in Normative Foraging Decision Strategies},
  author = {Kilpatrick, Zachary P. and Davidson, Jacob D. and El Hady, Ahmed},
