  title = {Orexins and Orexin Receptors: A Family of Hypothalamic Neuropeptides and {{G}} Protein-Coupled Receptors That Regulate Feeding Behavior},
  shorttitle = {Orexins and Orexin Receptors},
  author = {Sakurai, T. and Amemiya, A. and Ishii, M. and Matsuzaki, I. and Chemelli, R. M. and Tanaka, H. and Williams, S. C. and Richardson, J. A. and Kozlowski, G. P. and Wilson, S. and Arch, J. R. and Buckingham, R. E. and Haynes, A. C. and Carr, S. A. and Annan, R. S. and McNulty, D. E. and Liu, W. S. and Terrett, J. A. and Elshourbagy, N. A. and Bergsma, D. J. and Yanagisawa, M.},
  date = {1998-02-20},
