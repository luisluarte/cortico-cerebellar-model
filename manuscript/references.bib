}

@article{begelDuetSynchronizationInterventions2024,
  title = {Duet Synchronization Interventions Affect Social Interactions},
  author = {Bégel, Valentin and Demos, Alexander P. and Palmer, Caroline},
  date = {2024},
  journaltitle = {Scientific Reports},
  shortjournal = {Sci. Rep.},
  volume = {14},
