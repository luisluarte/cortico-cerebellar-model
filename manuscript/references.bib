@article{gouldExaptationCrucialTool1991,
  title = {Exaptation: {{A Crucial Tool}} for an {{Evolutionary Psychology}}},
  shorttitle = {Exaptation},
  author = {Gould, Stephen Jay},
  date = {1991},
  journaltitle = {Journal of Social Issues},
  shortjournal = {J. Soc. Issues},
  volume = {47},
  number = {3},
  pages = {43--65},
  issn = {1540-4560},
  doi = {10.1111/j.1540-4560.1991.tb01822.x},
  url = {https://onlinelibrary.wiley.com/doi/abs/10.1111/j.1540-4560.1991.tb01822.x},
  urldate = {2025-05-12},
  abstract = {Evolutionary theory lacks a term for a crucial concept—a feature, now useful to an organism, that did not arise as an adaptation for its present role, but was subsequently coopted for its current function. I call such features “exaptations” and show that they are neither rare nor arcane, but dominant features of evolution—though previously unappreciated in the context of the overly adaptationist neo-Darwinian theory. This article argues that exaptation overcomes the fallacy of human sociobiology, helps us to understand the major patterns of flexibility and contingency in life's history, revises the roles of structure and function in evolutionary theory, serves as a centerpiece for grasping the origin and meaning of brain size in human evolution, and thereby cries out for recognition as a key to evolutionary psychology. Historical origin and current utility are distinct concepts and must never be conflated.},
  langid = {english},
  file = {C\:\\Users\\DCCS5\\Zotero\\storage\\38MARXTL\\Gould - 1991 - Exaptation A Crucial Tool for an Evolutionary Psychology.pdf;C\:\\Users\\DCCS5\\Zotero\\storage\\MTE6CZGQ\\j.1540-4560.1991.tb01822.html}
}

