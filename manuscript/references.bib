@article{valdebenito-oyarzoParietalCortexHas2024,
  title = {The Parietal Cortex Has a Causal Role in Ambiguity Computations in Humans},
  author = {Valdebenito-Oyarzo, Gabriela and Martínez-Molina, María Paz and Soto-Icaza, Patricia and Zamorano, Francisco and Figueroa-Vargas, Alejandra and Larraín-Valenzuela, Josefina and Stecher, Ximena and Salinas, César and Bastin, Julien and Valero-Cabré, Antoni and Polania, Rafael and Billeke, Pablo},
