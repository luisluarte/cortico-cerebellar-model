@article{mcphersonIntrinsicRhythmicityPredicts2018,
  title = {Intrinsic {{Rhythmicity Predicts Synchronization-Continuation Entrainment Performance}}},
  author = {McPherson, Trevor and Berger, D. and Alagapan, Sankaraleengam (Sankar) and Fröhlich, Flavio},
  date = {2018},
  journaltitle = {Scientific Reports},
