@article{soltaniAdaptiveLearningExpected2019,
  title = {Adaptive Learning under Expected and Unexpected Uncertainty},
  author = {Soltani, Alireza and Izquierdo, Alicia},
  date = {2019-10},
  journaltitle = {Nature Reviews. Neuroscience},
