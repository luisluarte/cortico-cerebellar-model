@article{leeFoodCravingSeeking2019,
  title = {Food {{Craving}}, {{Seeking}}, and {{Consumption Behaviors}}: {{Conceptual Phases}} and {{Assessment Methods Used}} in {{Animal}} and {{Human Studies}}},
