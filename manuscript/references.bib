@article{miedaOrexinPeptidesPrevent2004,
  title = {Orexin Peptides Prevent Cataplexy and Improve Wakefulness in an Orexin Neuron-Ablated Model of Narcolepsy in Mice.},
  author = {Mieda, Michihiro and Willie, J. and Hara, J. and Sinton, C. and Sakurai, T. and Yanagisawa, M.},
