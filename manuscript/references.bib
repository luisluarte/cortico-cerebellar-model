  issn = {1545-7885},
  doi = {10.1371/journal.pbio.3002452},
  url = {https://dx.plos.org/10.1371/journal.pbio.3002452},
  urldate = {2024-09-02},
  abstract = {Humans often face the challenge of making decisions between ambiguous options. The level of ambiguity in decision-making has been linked to activity in the parietal cortex, but its exact computational role remains elusive. To test the hypothesis that the parietal cortex plays a causal role in computing ambiguous probabilities, we conducted consecutive fMRI and TMS-EEG studies. We found that participants assigned unknown probabilities to objective probabilities, elevating the uncertainty of their decisions. Parietal cortex activity correlated with the objective degree of ambiguity and with a process that underestimates the uncertainty during decision-making. Conversely, the midcingulate cortex (MCC) encodes prediction errors and increases its connectivity with the parietal cortex during outcome processing. Disruption of the parietal activity increased the uncertainty evaluation of the options, decreasing cingulate cortex oscillations during outcome evaluation and lateral frontal oscillations related to value ambiguous probability. These results provide evidence for a causal role of the parietal cortex in computing uncertainty during ambiguous decisions made by humans.},
  langid = {english},
  file = {C:\Users\DCCS5\Zotero\storage\VZE6Q49A\Valdebenito-Oyarzo et al. - 2024 - The parietal cortex has a causal role in ambiguity.pdf}
}

@article{valdesHistaminergicTuberomammillaryNucleus2010,
  title = {The Histaminergic Tuberomammillary Nucleus Is Critical for Motivated Arousal},
