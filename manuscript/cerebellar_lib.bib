@article{harunoMosaicModelSensorimotor2001,
  title = {Mosaic Model for Sensorimotor Learning and Control},
  author = {Haruno, M. and Wolpert, D. M. and Kawato, M.},
  date = {2001-10},
  journaltitle = {Neural Computation},
  shortjournal = {Neural Comput.},
