  title = {Dynamic Cortical and Subcortical Networks in Learning and Delayed Recall of Timed Motor Sequences},
  author = {Penhune, Virginia B. and Doyon, Julien},
  date = {2002-02-15},
  journaltitle = {The Journal of Neuroscience: The Official Journal of the Society for Neuroscience},
