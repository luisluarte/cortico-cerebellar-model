# execution ---------------------------------------------------------------
sample_sizes <- c(10, 20, 30, length(unique(dat$participant_id)))
data_sets <- sample_sizes %>%
map(., function(SIZE) {
pid <- sample(unique(dat$participant_id), size = SIZE, replace = FALSE)
dat_out <- dat %>%
filter(participant_id %in% pid)
return(dat_out)
})
data_sets
View(dat)
data_sets <- sample_sizes %>%
map(., function(SIZE) {
pid <- sample(unique(dat$participant_id), size = SIZE, replace = FALSE)
dat_out <- dat %>%
filter(participant_id %in% pid)
FILENAME <- paste0("../../", "/data_size_", SIZE, ".rds")
write_rds(x = dat_out, file = FILENAME)
})
