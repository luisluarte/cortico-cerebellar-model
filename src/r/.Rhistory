compute_S <- function(params, lower_bounds, upper_bounds) {
D <- ncol(params)
norm_params <- sweep(params, 2, lower_bounds, "-")
norm_params <- sweep(norm_params, 2, upper_bounds - lower_bounds, "/")
v1 <- as.numeric(norm_params[1, ]) # Q1 (25th)
v2 <- as.numeric(norm_params[2, ]) # Q2 (50th)
v3 <- as.numeric(norm_params[3, ]) # Q3 (75th)
L <- sqrt(sum((v2 - v1)^2)) + sqrt(sum((v3 - v2)^2))
S <- L / sqrt(D)
return(S)
}
compute_S <- function(params, lower_bounds, upper_bounds) {
D <- ncol(params)
norm_params <- sweep(params, 2, lower_bounds, "-")
norm_params <- sweep(norm_params, 2, upper_bounds - lower_bounds, "/")
v1 <- as.numeric(norm_params[1, ]) # Q1 (25th)
v2 <- as.numeric(norm_params[2, ]) # Q2 (50th)
v3 <- as.numeric(norm_params[3, ]) # Q3 (75th)
L <- sqrt(sum((v2 - v1)^2)) + sqrt(sum((v3 - v2)^2))
S <- L / sqrt(D)
return(S)
}
wsls_p <- subset(df, Model == "WSLS")[, c("theta_win", "theta_loss")]
wsls_L <- c(0.001, 0.001)
wsls_U <- c(0.999, 0.999)
# parameter stability
data_p6 <- read_rds("../../results/parameter_stability.rds") %>%
as_tibble()
compute_S <- function(params, lower_bounds, upper_bounds) {
D <- ncol(params)
norm_params <- sweep(params, 2, lower_bounds, "-")
norm_params <- sweep(norm_params, 2, upper_bounds - lower_bounds, "/")
v1 <- as.numeric(norm_params[1, ]) # Q1 (25th)
v2 <- as.numeric(norm_params[2, ]) # Q2 (50th)
v3 <- as.numeric(norm_params[3, ]) # Q3 (75th)
L <- sqrt(sum((v2 - v1)^2)) + sqrt(sum((v3 - v2)^2))
S <- L / sqrt(D)
return(S)
}
df <- data_p6
wsls_p <- subset(df, Model == "WSLS")[, c("theta_win", "theta_loss")]
wsls_L <- c(0.001, 0.001)
wsls_U <- c(0.999, 0.999)
S_wsls <- compute_S(wsls_p, wsls_L, wsls_U)
qlearn_p <- subset(df, Model == "QLearn")[, c("alpha_win", "alpha_loss", "beta")]
qlearn_L <- c(0.001, 0.001, 0.1)
qlearn_U <- c(0.999, 0.999, 10.0)
S_qlearn <- compute_S(qlearn_p, qlearn_L, qlearn_U)
bio_p <- subset(df, Model == "Bio")[, c("alpha_pc", "lambda_pc", "beta_thal",
"kappa_cf", "alpha_gran", "beta_gran", "sigma2_diff")]
bio_L <- c(0.001, 0.001, 0.001, 0.0001, 0.001, 0.001, 0.001)
bio_U <- c(1.500, 1.500, 0.500, 0.1000, 1.000, 1.000, 0.500)
S_bio <- compute_S(bio_p, bio_L, bio_U)
S_bio
S_qlearn
S_wsls
View(data_p6)
