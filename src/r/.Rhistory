# Load required libraries
if (!require(ggplot2)) install.packages("ggplot2")
library(ggplot2)
# 1. Environmental Axiom: 1000 trials, deterministic block reversals every 100 trials
trials <- 1000
block_size <- 100
R_seq <- rep(rep(c(1, 0), each = block_size), length.out = trials)
# 2. HMM Cortical Prior & Hyperparameters
hazard_rate <- 0.05       # Prior belief of volatility (5% chance of state switch per trial)
theta_true <- 0.95        # Likelihood of reward given correct state (allowing 5% noise tolerance)
# Storage manifolds
B_t <- numeric(trials)    # Posterior belief P(S_t = A)
U_t <- numeric(trials)    # Shannon Entropy
# Initialize uniform prior (Maximum uncertainty)
current_B <- 0.5
# 3. The Optimal Bayesian Forward Pass
for (t in 1:trials) {
# A. Prediction Step (Incorporate Hazard Rate)
B_pred <- current_B * (1 - hazard_rate) + (1 - current_B) * hazard_rate
# B. Likelihood Evaluation
# Assuming action A was taken:
if (R_seq[t] == 1) {
L_A <- theta_true
L_B <- 1 - theta_true
} else {
L_A <- 1 - theta_true
L_B <- theta_true
}
# C. Update Step (Bayes Rule via Chapman-Kolmogorov)
marginal_likelihood <- (B_pred * L_A) + ((1 - B_pred) * L_B)
current_B <- (B_pred * L_A) / marginal_likelihood
# D. Calculate Shannon Entropy (Cortical Engagement)
# Bounded slightly away from 0/1 to prevent log2(0) computational errors
safe_B <- max(min(current_B, 1 - 1e-9), 1e-9)
entropy <- -(safe_B * log2(safe_B) + (1 - safe_B) * log2(1 - safe_B))
# Store trial state
B_t[t] <- current_B
U_t[t] <- entropy
}
cortical_proxy_df <- data.frame(Trial = 1:trials, Reward = R_seq,
State_Belief = B_t, Cortical_Entropy = U_t)
# 4. Publication-Ready Theme Functor (Physics Aesthetic)
theme_physics <- function(base_size = 12, base_family = "serif") {
theme_bw(base_size = base_size, base_family = base_family) %+replace%
theme(
panel.grid.major = element_blank(),
panel.grid.minor = element_blank(),
panel.border = element_rect(color = "black", fill = NA, linewidth = 1),
panel.background = element_rect(fill = "white", color = NA),
axis.ticks = element_line(color = "black", linewidth = 0.5),
axis.ticks.length = unit(-0.15, "cm"),
axis.text.x = element_text(margin = margin(t = 0.3, unit = "cm"), color = "black"),
axis.text.y = element_text(margin = margin(r = 0.3, unit = "cm"), color = "black"),
axis.text.y.right = element_text(margin = margin(l = 0.3, unit = "cm"), color = "black"),
axis.title = element_text(face = "bold"),
legend.position = "top",
legend.title = element_blank(),
legend.key = element_blank(),
legend.background = element_blank()
)
}
# 5. Rendering the HMM Manifold
fig_physics <- ggplot(cortical_proxy_df, aes(x = Trial)) +
geom_point(aes(y = Reward, shape = "Observed Reward"), size = 1.5, alpha = 0.3) +
geom_line(aes(y = State_Belief, linetype = "Belief in State A (B)"), linewidth = 0.8) +
geom_line(aes(y = Cortical_Entropy, color = "Cortical Entropy (U)"), linewidth = 0.8) +
scale_y_continuous(
name = Base::expression(bold(State~Belief~(B[t]))),
limits = c(-0.05, 1.05),
sec.axis = sec_axis(~ ., name = Base::expression(bold(Cortical~Entropy~(U[t])))) # Entropy bounds strictly 0-1
) +
scale_shape_manual(values = c("Observed Reward" = 1)) +
scale_linetype_manual(values = c("Belief in State A (B)" = "solid")) +
scale_color_manual(values = c("Cortical Entropy (U)" = "blue")) +
theme_physics()
# Load required library for interactive manifold
if (!require(plotly)) install.packages("plotly")
library(plotly)
# 1. Environmental Axiom: Stochastic Reversal Task
set.seed(42) # For reproducible manifolds
trials <- 200
reversal_point <- 100
# Hidden States: State 1 (Hand 1 Optimal), State 2 (Hand 2 Optimal)
true_states <- c(rep(1, reversal_point), rep(2, trials - reversal_point))
# True contingencies
theta_opt <- 0.85
theta_sub <- 0.15
# Generate stochastic rewards for Hand 1 based on the hidden state
rewards <- numeric(trials)
for(t in 1:trials) {
if(true_states[t] == 1) {
rewards[t] <- rbinom(1, 1, theta_opt)
} else {
rewards[t] <- rbinom(1, 1, theta_sub)
}
}
# 2. HMM Cortical Prior & Hyperparameters
hazard_rate <- 0.05
# Observer knows the true generative contingencies
L_opt <- theta_opt
L_sub <- theta_sub
# Storage manifolds
B_t <- numeric(trials)    # Posterior belief P(S_t = 1)
U_t <- numeric(trials)    # Shannon Entropy
# Initialize maximum uncertainty
current_B <- 0.5
# 3. The Isolated Epistemic Filter (Chapman-Kolmogorov)
for (t in 1:trials) {
# A. Prediction Step
B_pred <- current_B * (1 - hazard_rate) + (1 - current_B) * hazard_rate
# B. Likelihood Evaluation for observed Reward
if (rewards[t] == 1) {
L_1 <- L_opt
L_2 <- L_sub
} else {
L_1 <- 1 - L_opt
L_2 <- 1 - L_sub
}
# C. Update Step (Bayes Rule)
marginal_likelihood <- (B_pred * L_1) + ((1 - B_pred) * L_2)
current_B <- (B_pred * L_1) / marginal_likelihood
# D. Entropy Extraction
safe_B <- max(min(current_B, 1 - 1e-9), 1e-9)
entropy <- -(safe_B * log2(safe_B) + (1 - safe_B) * log2(1 - safe_B))
B_t[t] <- current_B
U_t[t] <- entropy
}
cortical_df <- data.frame(
Trial = 1:trials,
Reward = rewards,
True_State = true_states,
State_Belief = B_t,
Cortical_Entropy = U_t
)
# 4. Interactive Rendering
fig <- plot_ly(cortical_df, x = ~Trial) %>%
# Trace 1: The Stochastic Reward Stream
add_markers(y = ~Reward, name = "Observed Reward (Hand 1)",
marker = list(color = 'rgba(0,0,0,0.3)', symbol = 'circle', size = 8)) %>%
# Trace 2: The Agent's Belief
add_lines(y = ~State_Belief, name = "Belief P(S=1)",
line = list(color = '#2ca02c', width = 3)) %>%
# Trace 3: True Hidden State (Scaled to 0-1 for visual overlay)
add_lines(y = ~ifelse(True_State == 1, 1, 0), name = "True Hidden State",
line = list(color = 'rgba(0,0,0,0.2)', dash = 'dot', width = 2)) %>%
# Trace 4: Cortical Entropy (Engagement)
add_lines(y = ~Cortical_Entropy, name = "Cortical Entropy (U_t)",
yaxis = "y2", line = list(color = '#d62728', width = 3)) %>%
layout(
title = "Isolated HMM Epistemic Filter",
xaxis = list(title = "Trial Index", dtick = 20),
yaxis = list(title = "Belief / Reward", range = c(-0.1, 1.1)),
yaxis2 = list(title = "Shannon Entropy (U_t)", overlaying = "y", side = "right",
showgrid = FALSE, color = '#d62728', range = c(0, 1.05)),
legend = list(orientation = 'h', x = 0.5, y = 1.15, xanchor = 'center'),
plot_bgcolor = "white",
paper_bgcolor = "white"
)
fig
# Load required library for interactive manifold
if (!require(plotly)) install.packages("plotly")
library(plotly)
# 1. Environmental Axiom: Stochastic Reversal Task
set.seed(42)
trials <- 200
reversal_point <- 100
# Hidden States & True contingencies
true_states <- c(rep(1, reversal_point), rep(2, trials - reversal_point))
theta_opt <- 0.85
theta_sub <- 0.15
# Generate stochastic rewards
rewards <- numeric(trials)
for(t in 1:trials) {
rewards[t] <- ifelse(true_states[t] == 1,
rbinom(1, 1, theta_opt),
rbinom(1, 1, theta_sub))
}
# 2. HMM Cortical Prior & Hyperparameters
hazard_rate <- 0.05
L_opt <- theta_opt
L_sub <- theta_sub
# Storage manifolds
B_t <- numeric(trials)
U_t <- numeric(trials)
current_B <- 0.5
# 3. The Isolated Epistemic Filter (Chapman-Kolmogorov)
for (t in 1:trials) {
# Prediction Step
B_pred <- current_B * (1 - hazard_rate) + (1 - current_B) * hazard_rate
# Likelihood Evaluation
L_1 <- ifelse(rewards[t] == 1, L_opt, 1 - L_opt)
L_2 <- ifelse(rewards[t] == 1, L_sub, 1 - L_sub)
# Update Step
marginal_likelihood <- (B_pred * L_1) + ((1 - B_pred) * L_2)
current_B <- (B_pred * L_1) / marginal_likelihood
# Entropy Extraction
safe_B <- max(min(current_B, 1 - 1e-9), 1e-9)
B_t[t] <- current_B
U_t[t] <- -(safe_B * log2(safe_B) + (1 - safe_B) * log2(1 - safe_B))
}
# 4. The Causal Convolution Functor (Generative Smoothing)
sigma <- 2.0
window <- ceiling(3 * sigma)
# Generate a STRICTLY CAUSAL Half-Gaussian kernel (tau >= 0)
# Index 1 corresponds to lag 0 (current trial t), Index 2 to lag 1 (t-1), etc.
causal_kernel <- dnorm(seq(0, window), mean = 0, sd = sigma)
causal_kernel <- causal_kernel / sum(causal_kernel) # Normalize to maintain scale
# Apply causal convolution (sides = 1 ensures no future data is used)
# U_t_smoothed[t] = w_0*U_t + w_1*U_{t-1} + ...
U_t_causal <- stats::filter(U_t, causal_kernel, sides = 1)
# Handle NA boundaries for the initial trials where history < window length
# We carry forward the raw U_t for the burn-in period to avoid NAs
U_t_causal[is.na(U_t_causal)] <- U_t[is.na(U_t_causal)]
U_t_causal <- as.numeric(U_t_causal)
cortical_df <- data.frame(
Trial = 1:trials,
Reward = rewards,
True_State = true_states,
Raw_Entropy = U_t,
Causal_Entropy = U_t_causal
)
# 5. Interactive Rendering
fig <- plot_ly(cortical_df, x = ~Trial) %>%
# Trace 1: The Stochastic Reward Stream
add_markers(y = ~Reward, name = "Observed Reward",
marker = list(color = 'rgba(0,0,0,0.3)', symbol = 'circle', size = 8)) %>%
# Trace 2: True Hidden State
add_lines(y = ~ifelse(True_State == 1, 1, 0), name = "True Hidden State",
line = list(color = 'rgba(0,0,0,0.2)', dash = 'dot', width = 2)) %>%
# Trace 3: Raw Cortical Entropy (Instantaneous Logic)
add_lines(y = ~Raw_Entropy, name = "Raw Entropy (U_t)",
yaxis = "y2", line = list(color = 'rgba(214, 39, 40, 0.3)', dash = 'dash', width = 2)) %>%
# Trace 4: Causal Biological Envelope (Generative)
add_lines(y = ~Causal_Entropy, name = "Causal Envelope",
yaxis = "y2", line = list(color = 'rgba(214, 39, 40, 1)', width = 4)) %>%
layout(
title = "Epistemic Filter with Causal (Half-Gaussian) Biological Smoothing",
xaxis = list(title = "Trial Index", dtick = 20),
yaxis = list(title = "Reward State", range = c(-0.1, 1.1)),
yaxis2 = list(title = "Shannon Entropy", overlaying = "y", side = "right",
showgrid = FALSE, color = '#d62728', range = c(0, 1.05)),
legend = list(orientation = 'h', x = 0.5, y = 1.15, xanchor = 'center'),
plot_bgcolor = "white",
paper_bgcolor = "white"
)
fig
