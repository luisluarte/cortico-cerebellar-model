dat
# data --------------------------------------------------------------------
dat <- read_csv("../../data/raw/behavioral_compilate.csv") %>%
arrange(participant_id, nt) %>%
group_by(participant_id) %>%
mutate(
stay_switch = if_else(
Resp == lag(Resp, n = 1),
"stay",
"switch"
),
stay_switch = replace_na(stay_switch, "stay"),
reward = as.numeric(`F`),
rt_raw = (ttr - ttp) / 1000,
rt = ifelse(rt_raw < 0.15 | rt_raw > 5.0, -999, rt_raw),
iti = replace_na(ttp - lag(ttF, n = 1), 0)
) %>%
ungroup()
# data --------------------------------------------------------------------
dat <- read_csv("../../data/behavioral_compilate.csv") %>%
arrange(participant_id, nt) %>%
group_by(participant_id) %>%
mutate(
stay_switch = if_else(
Resp == lag(Resp, n = 1),
"stay",
"switch"
),
stay_switch = replace_na(stay_switch, "stay"),
reward = as.numeric(`F`),
rt_raw = (ttr - ttp) / 1000,
rt = ifelse(rt_raw < 0.15 | rt_raw > 5.0, -999, rt_raw),
